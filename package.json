{
  "name": "dota3",
  "private": true,
  "description": "Мобильная MOBA для телефона. Сама игра не требует сборки; пакеты нужны только для APK.",
  "scripts": {
    "www": "rm -rf www && mkdir www && cp -r index.html style.css manifest.webmanifest sw.js icons vendor src assets www/",
    "android": "npm run www && npx cap add android && npx cap sync android",
    "test:input": "node tests/input.spec.mjs",
    "test:combat": "node tests/combat.spec.mjs",
    "test:ui": "node tests/ui.spec.mjs",
    "test:onboarding": "node tests/onboarding.spec.mjs",
    "test:hits": "node tests/hits.spec.mjs",
    "test:projectile": "node tests/projectile.spec.mjs",
    "test:visibility": "node tests/visibility.spec.mjs",
    "test:ai": "node tests/ai.spec.mjs",
    "sim": "node tools/sim.mjs",
    "sim:report": "node tools/sim-report.mjs",
    "sim:resources": "node --expose-gc tools/sim-resources.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/cli": "6.2.2",
    "@capacitor/core": "6.2.2",
    "playwright": "1.56.1"
  }
}
